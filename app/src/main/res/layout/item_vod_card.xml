<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card"
    android:focusable="true">

    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp"
        android:background="@color/card">
        <ImageView android:id="@+id/iv_thumb"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView android:id="@+id/iv_placeholder"
            android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_film" android:tint="@color/text3"/>
        <TextView android:id="@+id/tv_rating"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="4dp"
            android:background="@drawable/bg_rating_badge"
            android:paddingStart="5dp" android:paddingEnd="5dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="@color/accent2" android:textSize="10sp" android:textStyle="bold"
            android:visibility="gone"/>
    </FrameLayout>

    <TextView android:id="@+id/tv_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="6dp" android:textColor="@color/text"
        android:textSize="11sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
