<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/bg2"
    android:maxHeight="600dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="13dp" android:paddingEnd="13dp"
        android:background="@color/bg">
        <Button android:id="@+id/btn_close"
            android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/bg_channel_logo"
            android:text="✕" android:textColor="@color/text2" android:textSize="13sp"
            android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"/>
        <TextView android:id="@+id/tv_series_title"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp"
            android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="42dp"
        android:scrollbars="none" android:paddingStart="10dp" android:paddingEnd="10dp">
        <LinearLayout android:id="@+id/season_tabs"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical" android:gap="6dp"/>
    </HorizontalScrollView>

    <ProgressBar android:id="@+id/pb_loading"
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="center" android:indeterminate="true"
        android:indeterminateTint="@color/accent" android:layout_margin="16dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout android:id="@+id/episode_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
