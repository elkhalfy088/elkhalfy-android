<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="10dp" android:paddingEnd="10dp"
    android:paddingTop="7dp" android:paddingBottom="7dp">
    <TextView android:id="@+id/tv_rank"
        android:layout_width="22dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text2" android:textSize="11sp" android:textStyle="bold"/>
    <ImageView android:id="@+id/iv_team_logo"
        android:layout_width="15dp" android:layout_height="15dp"
        android:layout_marginStart="2dp" android:scaleType="centerInside"/>
    <TextView android:id="@+id/tv_team_name"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="5dp"
        android:textColor="@color/text" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/tv_played"
        android:layout_width="26dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text2" android:textSize="11sp"/>
    <TextView android:id="@+id/tv_wins"
        android:layout_width="26dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text2" android:textSize="11sp"/>
    <TextView android:id="@+id/tv_losses"
        android:layout_width="26dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text2" android:textSize="11sp"/>
    <TextView android:id="@+id/tv_draws"
        android:layout_width="26dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text2" android:textSize="11sp"/>
    <TextView android:id="@+id/tv_points"
        android:layout_width="32dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/accent2" android:textSize="11sp" android:textStyle="bold"/>
</LinearLayout>
